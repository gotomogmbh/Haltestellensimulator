.svelte-kit/
.vite/

# Environment
.env
.env.local
.env.*.local
!.env.example

# OS
.DS_Store
Thumbs.db
*.swp
*.swo

# Editors / IDEs
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.iml

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Tests / coverage
coverage/
.nyc_output/
*.lcov

# Caches
.cache/
.parcel-cache/
.eslintcache
.turbo/

# TypeScript
*.tsbuildinfo

# Python (falls Skripte für Datenaufbereitung dazukommen)
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/

# Lokale Uploads & verarbeitete Artefakte — Inhalt ignorieren, Struktur behalten
storage/uploads/excel/*
storage/uploads/gtfs/*
storage/uploads/poi/*
storage/processed/*
!storage/uploads/excel/.gitkeep
!storage/uploads/gtfs/.gitkeep
!storage/uploads/poi/.gitkeep
!storage/processed/.gitkeep

# Sample-Daten sind committet, aber grosse Binärdumps nicht
data/samples/*.zip
data/samples/*.tar.gz
data/samples/_local/

# Temp
tmp/
temp/
*.tmp
