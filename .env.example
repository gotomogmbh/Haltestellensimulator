# Haltestellensimulator — Environment-Variablen
# Lokale Kopie als `.env` ablegen (wird von .gitignore ausgeschlossen).

# --- App ---
APP_ENV=development
APP_PORT=5173

# --- Storage (lokal im MVP) ---
STORAGE_ROOT=./storage
STORAGE_UPLOADS_EXCEL=./storage/uploads/excel
STORAGE_UPLOADS_GTFS=./storage/uploads/gtfs
STORAGE_UPLOADS_POI=./storage/uploads/poi
STORAGE_PROCESSED=./storage/processed

# --- GTFS ---
# Quelle: opentransportdata.swiss — URL des aktuellen GTFS-Pakets oder lokaler Pfad
GTFS_SOURCE_URL=
GTFS_LOCAL_PATH=./storage/uploads/gtfs/latest.zip

# --- OSM ---
# Karten-Tiles (Standard: offizielle OSM-Tiles — für Produktion eigenen Tile-Server / kostenpflichtigen Provider erwägen)
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
OSM_TILE_ATTRIBUTION=© OpenStreetMap contributors

# Geocoding / POI-Lookups — NUR für manuell ausgelöste Einzel-Lookups verwenden.
# Kein Bulk-Geocoding gegen diese öffentlichen Endpunkte!
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter

# Pflicht-Header für Nominatim-Usage-Policy (eigene Kontakt-E-Mail eintragen)
OSM_NOMINATIM_USER_AGENT=Haltestellensimulator/0.1 (kontakt@example.ch)

# --- Logging ---
LOG_LEVEL=info
IMPORT_LOG_PATH=./storage/processed/import-log.jsonl
